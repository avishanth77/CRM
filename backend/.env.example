# ==============================================================================
# TEXOL Configurable PLD CRM Platform - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on your production server and customize the values below.

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically strong 50+ char secret key (e.g. using `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret-key-in-production

# Always set DEBUG to False in production
DEBUG=False

# Comma-separated list of fully qualified domain names and host IPs
ALLOWED_HOSTS=crm.texol.com,api.texol.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. PRODUCTION DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DB_NAME=texol_crm
DB_USER=texol_crm_user
DB_PASSWORD=YourStrongDatabasePasswordHere!
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. CORS & CSRF DOMAINS (Single-Page Application Client)
# ------------------------------------------------------------------------------
# Disable wildcard CORS in production
CORS_ALLOW_ALL_ORIGINS=False

# Comma-separated list of allowed frontend origins (HTTPS)
CORS_ALLOWED_ORIGINS=https://crm.texol.com,https://portal.texol.com

# Comma-separated list of trusted origins for CSRF verification
CSRF_TRUSTED_ORIGINS=https://crm.texol.com,https://portal.texol.com

# ------------------------------------------------------------------------------
# 4. HTTPS & SECURITY ENFORCEMENT
# ------------------------------------------------------------------------------
# Set to True when running behind an SSL/TLS reverse proxy (Nginx, Caddy, AWS ALB, Cloudflare)
SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# 5. INITIAL ADMINISTRATOR ACCOUNT (Used by initial seed routines)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@texol.com
ADMIN_PASSWORD=Admin@Texol2026!
